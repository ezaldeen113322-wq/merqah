      <div class="w-11 h-11 rounded-xl bg-white/15 border border-white/20 flex items-center justify-center text-2xl font-bold">م</div>
      <div>
        <h1 class="font-extrabold text-xl">مِرقاة</h1>
        <p class="text-xs text-emerald-100">متابعة حلقات القرآن الكريم</p>
      </div>
    </div>
    <button id="logoutBtn" onclick="logout()" class="hidden bg-rose-600 px-4 py-2 rounded-lg text-sm">خروج</button>
  </div>
</header>

<main class="flex-1 max-w-5xl w-full mx-auto p-4 py-6">

