];

const defaultData = {
  students: [
    {id:1,name:"أحمد عبدالله السالم",level:"جزء عمّ",code:"MRQ-101",attendance:"حاضر"},
    {id:2,name:"عمر خالد المنصور",level:"جزء تبارك",code:"MRQ-102",attendance:"حاضر"},
    {id:3,name:"يوسف إبراهيم الحربي",level:"جزء عمّ",code:"MRQ-103",attendance:"غائب"}
  ],
  recitations: [
    {id:101,studentId:1,type:"حفظ جديد",surah:"النبأ",from:1,to:20,grade:"ممتاز",note:"تلاوة متقنة",date:new Date().toISOString()},
    {id:102,studentId:2,type:"مراجعة",surah:"الملك",from:1,to:30,grade:"جيد جداً",note:"مراجعة كاملة",date:new Date().toISOString()}
  ]
};

function loadData() {
  try {
    const saved = localStorage.getItem("mirqah_data");
    if (!saved) return structuredClone(defaultData);
    const parsed = JSON.parse(saved);
    if (!Array.isArray(parsed.students) || !Array.isArray(parsed.recitations)) {
      return structuredClone(defaultData);
    }
    return parsed;
  } catch (error) {
    console.error("تعذر تحميل البيانات:", error);
    return structuredClone(defaultData);
  }
}

let state = loadData();
let currentParentId = null;

