      <div class="flex border-b">
        <button id="adminTab" onclick="switchLoginTab('admin')" class="flex-1 p-4 font-bold text-sm text-emerald-800 bg-emerald-50">المشرف / المعلم</button>
        <button id="parentTab" onclick="switchLoginTab('parent')" class="flex-1 p-4 font-bold text-sm text-slate-500">ولي الأمر</button>
