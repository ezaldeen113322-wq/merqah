function setAttendance(id,status) {
  const student = state.students.find(s => s.id === id);
  if (!student) return;
  student.attendance = status;
  saveState();
}

function addStudent() {
  const name = document.getElementById("newStudentName").value.trim();
  const level = document.getElementById("newStudentLevel").value.trim() || "غير محدد";

  if (!name) {
    alert("يرجى كتابة اسم الطالب.");
    return;
  }

  const nextNumber = Math.max(
    100,
    ...state.students.map(s => Number(String(s.code).replace("MRQ-","")) || 100)
  ) + 1;

  state.students.push({
    id:Date.now(),
    name,
    level,
    code:"MRQ-" + nextNumber,
    attendance:"لم يحضر بعد"
  });

  document.getElementById("newStudentName").value = "";
  document.getElementById("newStudentLevel").value = "";
  saveState();
  alert("تمت إضافة الطالب بنجاح. رمزه: MRQ-" + nextNumber);
}

function addRecitation() {
  const studentId = Number(document.getElementById("recStudent").value);
  const type = document.getElementById("recType").value;
  const surah = document.getElementById("recSurah").value;
  const grade = document.getElementById("recGrade").value;
  const from = Number(document.getElementById("recFrom").value);
  const to = Number(document.getElementById("recTo").value);
  const note = document.getElementById("recNote").value.trim();

  if (!studentId) {
    alert("أضف طالباً أولاً.");
    return;
  }

  if (!from  !to  from < 1 || to < from) {
    alert("يرجى التأكد من أرقام الآيات.");
    return;
  }

  state.recitations.unshift({
    id:Date.now(),studentId,type,surah,from,to,grade,note,
    date:new Date().toISOString()
  });

  document.getElementById("recNote").value = "";
  saveState();
  alert("تم حفظ سجل التسميع.");
}

