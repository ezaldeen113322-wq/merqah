          <input id="adminPassword" type="password" placeholder="كلمة المرور" class="w-full border rounded-xl p-3 text-sm">
        </div>
        <button onclick="demoLogin()" class="w-full bg-emerald-700 text-white p-3 rounded-xl font-bold">دخول تجريبي للمشرف</button>
