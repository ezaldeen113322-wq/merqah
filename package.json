        </div>
      ;
    }).join("") || '<p class="text-sm text-slate-400">لا توجد سجلات.</p>';

  if (currentParentId !== null) renderParent();
}

function renderReport() {
  const weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;
  const lines = state.students.map(s => {
    const records = state.recitations.filter(r =>
      r.studentId === s.id && new Date(r.date).getTime() >= weekAgo
    );
    const details = records.length ?
      records.map(r => ${r.type}: سورة ${r.surah} (${r.from}-${r.to}) - ${r.grade}).join(" | ") :
      "لا توجد سجلات خلال الأسبوع";

    return • ${s.name}\n  الحضور: ${s.attendance}\n  ${details};
  });

  document.getElementById("weeklyReport").textContent =
    تقرير حلقة مِرقاة الأسبوعي\nالتاريخ: ${new Date().toLocaleDateString("ar-SA")}\n\n${lines.join("\n\n")};
}

async function copyReport() {
  const report = document.getElementById("weeklyReport").textContent;
  try {
    await navigator.clipboard.writeText(report);
    alert("تم نسخ التقرير.");
  } catch (error) {
    alert("تعذر النسخ تلقائياً. حدد التقرير وانسخه يدوياً.");
  }
}

function init() {
  const select = document.getElementById("recSurah");
  select.innerHTML = SURAHS.map(s =>
    <option value="${s}">سورة ${s}</option>
  ).join("");
  renderAll();
}

init();
</script>

</body>
</html>
