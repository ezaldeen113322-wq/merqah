<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#065f46">
  <title>مِرقاة - متابعة حلقات القرآن الكريم</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Cairo', sans-serif;
      background: #f8fafc;
      -webkit-tap-highlight-color: transparent;
    }
    .green-gradient {
      background: linear-gradient(135deg,#064e3b,#047857,#0f766e);
    }
    button:disabled { opacity: .5; cursor: not-allowed; }
    .tab-active { background:#047857;color:white; }
    .tab-normal { background:white;color:#475569;border:1px solid #e2e8f0; }
    input,select,textarea { max-width:100%; }
  </style>
</head>

<body class="min-h-screen flex flex-col text-slate-800">

<header class="green-gradient text-white shadow-md sticky top-0 z-30">
