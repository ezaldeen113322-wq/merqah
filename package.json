function saveState() {
  try {
    localStorage.setItem("mirqah_data", JSON.stringify(state));
    renderAll();
  } catch (error) {
    alert("تعذر حفظ البيانات على الجهاز.");
    console.error(error);
  }
}

function safeText(value) {
  return String(value ?? "").replace(/[&<>"']/g, char => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[char]);
}

function formatDate(date) {
  return new Date(date).toLocaleDateString("ar-SA");
}

function switchLoginTab(tab) {
  const admin = tab === "admin";
  document.getElementById("adminLogin").classList.toggle("hidden",!admin);
  document.getElementById("parentLogin").classList.toggle("hidden",admin);
  document.getElementById("adminTab").className =
    admin ? "flex-1 p-4 font-bold text-sm text-emerald-800 bg-emerald-50" :
    "flex-1 p-4 font-bold text-sm text-slate-500";
  document.getElementById("parentTab").className =
    !admin ? "flex-1 p-4 font-bold text-sm text-emerald-800 bg-emerald-50" :
    "flex-1 p-4 font-bold text-sm text-slate-500";
}

function demoLogin() {
  document.getElementById("loginView").classList.add("hidden");
  document.getElementById("parentView").classList.add("hidden");
  document.getElementById("adminView").classList.remove("hidden");
  document.getElementById("logoutBtn").classList.remove("hidden");
  showSection("attendance");
  renderAll();
}

function logout() {
  document.getElementById("adminView").classList.add("hidden");
  document.getElementById("parentView").classList.add("hidden");
  document.getElementById("loginView").classList.remove("hidden");
  document.getElementById("logoutBtn").classList.add("hidden");
  currentParentId = null;
}

function showSection(section) {
  ["attendance","recitation","students","reports"].forEach(name => {
    document.getElementById("sec-" + name).classList.toggle("hidden",name !== section);
    document.getElementById("nav-" + name).className =
      name === section ?
      "tab-active px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap" :
      "tab-normal px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap";
  });
  if (section === "reports") renderReport();
}

function parentLogin() {
  const code = document.getElementById("studentCode").value.trim().toUpperCase();
  const student = state.students.find(s => s.code.toUpperCase() === code);

  if (!student) {
    alert("رمز الطالب غير صحيح.");
    return;
  }

  currentParentId = student.id;
  document.getElementById("loginView").classList.add("hidden");
  document.getElementById("adminView").classList.add("hidden");
  document.getElementById("parentView").classList.remove("hidden");
  document.getElementById("logoutBtn").classList.remove("hidden");

  renderParent();
}

function renderParent() {
  const student = state.students.find(s => s.id === currentParentId);
  if (!student) return logout();

  document.getElementById("parentName").textContent = student.name;
  document.getElementById("parentLevel").textContent = "المستوى: " + student.level;
  document.getElementById("parentCode").textContent = "رمز الطالب: " + student.code;
  document.getElementById("parentAttendance").textContent = "حالة الحضور: " + student.attendance;

  const records = state.recitations.filter(r => r.studentId === student.id);
  document.getElementById("parentRecords").innerHTML = records.length ?
    records.map(r => 
      <div class="border rounded-xl p-3 bg-slate-50">
        <p class="font-bold text-sm">${safeText(r.type)} - سورة ${safeText(r.surah)}</p>
        <p class="text-xs text-slate-600 mt-1">من آية ${safeText(r.from)} إلى ${safeText(r.to)}</p>
        <p class="text-xs text-emerald-700 mt-1">التقدير: ${safeText(r.grade)}</p>
        <p class="text-xs text-slate-500 mt-1">${safeText(r.note || "لا توجد ملاحظات")}</p>
        <p class="text-xs text-slate-400 mt-1">${formatDate(r.date)}</p>
      </div>
    ).join("") :
    '<p class="text-sm text-slate-400">لا توجد سجلات حتى الآن.</p>';
}

